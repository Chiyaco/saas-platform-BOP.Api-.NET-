<style>

    .error-box {
        border: 1px solid #cc0000;
        padding: 15px;
        margin: 10px 0;
        border-radius: 5px;
    }

</style>

@if (!string.IsNullOrEmpty(Message))
{

    <div class="error-box">

        <strong>
            Error
        </strong>

        <p>
            @Message
        </p>

    </div>

}

@code {

    [Parameter]
    public string Message { get; set; } = string.Empty;
}
