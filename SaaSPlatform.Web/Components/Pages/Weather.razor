@page "/weather"
@attribute [StreamRendering]

<PageTitle>Weather</PageTitle>

<ApiGrid TItem="WeatherForecastDto"
    Endpoint="https://localhost:7214/WeatherForecast" 
    Columns="columns" />

@code {

    List<GridColumn<WeatherForecastDto>> columns =
[
    new()
    {
     Title="Date",
     Value=x=>x.Date.ToShortDateString()
    },
    new()
    {
     Title="TemperatureC",
     Value=x=>x.TemperatureC.ToString()
    },
     new()
    {
     Title="Summary",
     Value=x=>x.Summary
    },
     new()
    {
     Title="TemperatureF",
     Value=x=>x.TemperatureF.ToString()
    }
];

}
